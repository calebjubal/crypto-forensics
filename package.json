{
  "name": "satoshi-trace",
  "version": "1.0.4",
  "description": "Port-free offline desktop system for Bitcoin blockchain and network forensics",
  "keywords": [
    "bitcoin",
    "crypto",
    "forensics",
    "electron.js",
    "offline"
  ],
  "homepage": "https://github.com/calebjubal/crypto-forensics#readme",
  "bugs": {
    "url": "https://github.com/calebjubal/crypto-forensics/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/calebjubal/crypto-forensics.git"
  },
  "license": "ISC",
  "author": {
    "name": "BB9Kairo",
    "email": "85286527+calebjubal@users.noreply.github.com"
  },
  "desktopName": "satoshi-trace",
  "type": "commonjs",
  "main": "main.js",
  "scripts": {
    "build:css": "tailwindcss -i ./styles.input.css -o ./assets/app.css --minify",
    "start": "npm run build:css && electron .",
    "package": "npm run build:css && electron-builder --dir",
    "make": "npm run build:css && electron-builder",
    "dist": "npm run make",
    "publish": "node build/upload-draft.js --check && npm run make && node build/upload-draft.js",
    "test": "node --experimental-sqlite --test",
    "verify": "npm test && npm run package"
  },
  "build": {
    "appId": "com.calebjubal.satoshitrace",
    "productName": "Satoshi Trace",
    "executableName": "satoshi-trace",
    "asar": true,
    "electronFuses": {
      "runAsNode": false,
      "enableCookieEncryption": true,
      "enableNodeOptionsEnvironmentVariable": false,
      "enableNodeCliInspectArguments": false,
      "enableEmbeddedAsarIntegrityValidation": true,
      "onlyLoadAppFromAsar": true
    },
    "directories": {
      "output": "release"
    },
    "files": [
      "**/*",
      "!{.git,.github,.vscode,build,dist,out,release,test,test-support}/**",
      "!{README.md,CHANGELOG.md,RELEASE_NOTES_v*.md,styles.css,styles.input.css}"
    ],
    "publish": [
      {
        "provider": "github",
        "owner": "calebjubal",
        "repo": "crypto-forensics",
        "releaseType": "draft"
      }
    ],
    "win": {
      "icon": "assets/icon.ico",
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "linux": {
      "icon": "assets/icon.png",
      "category": "Utility",
      "syncDesktopName": true,
      "target": [
        "AppImage",
        "deb",
        "rpm"
      ]
    },
    "mac": {
      "category": "public.app-category.utilities",
      "target": [
        "dmg",
        "zip"
      ]
    }
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.3",
    "daisyui": "^5.7.22",
    "electron": "^44.0.0",
    "electron-builder": "^26.15.3",
    "tailwindcss": "^4.3.3"
  },
  "dependencies": {
    "animejs": "^4.1.3",
    "csv-parse": "6.1.0",
    "cytoscape": "^3.34.2",
    "saxes": "6.0.0",
    "stream-chain": "2.2.5",
    "stream-json": "1.9.1"
  }
}
