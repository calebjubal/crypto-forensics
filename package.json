{
  "name": "satoshi-trace",
  "version": "1.0.1",
  "description": "Port-free offline desktop system for Bitcoin blockchain and network forensics",
  "keywords": [
    "bitcoin",
    "crypto",
    "forensics",
    "electron.js",
    "offline"
  ],
  "homepage": "https://github.com/calebjubal/crypto-forensics#readme",
  "bugs": {
    "url": "https://github.com/calebjubal/crypto-forensics/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/calebjubal/crypto-forensics.git"
  },
  "license": "ISC",
  "author": "bb9kairo",
  "type": "commonjs",
  "main": "main.js",
  "scripts": {
    "build:css": "tailwindcss -i ./styles.input.css -o ./assets/app.css --minify",
    "start": "npm run build:css && electron-forge start",
    "package": "npm run build:css && electron-forge package",
    "make": "npm run build:css && electron-forge make",
    "publish": "npm run build:css && electron-forge publish",
    "test": "node --experimental-sqlite --test",
    "verify": "npm test && npm run package"
  },
  "devDependencies": {
    "@electron-forge/cli": "^7.11.2",
    "@electron-forge/maker-deb": "^7.11.2",
    "@electron-forge/maker-rpm": "^7.11.2",
    "@electron-forge/maker-squirrel": "^7.11.2",
    "@electron-forge/maker-zip": "^7.11.2",
    "@electron-forge/plugin-auto-unpack-natives": "^7.11.2",
    "@electron-forge/plugin-fuses": "^7.11.2",
    "@electron-forge/publisher-github": "^7.11.2",
    "@electron/fuses": "^1.8.0",
    "@tailwindcss/cli": "^4.3.3",
    "daisyui": "^5.7.22",
    "electron": "^44.0.0",
    "tailwindcss": "^4.3.3"
  },
  "dependencies": {
    "animejs": "^4.1.3",
    "csv-parse": "6.1.0",
    "electron-squirrel-startup": "^1.0.1",
    "saxes": "6.0.0",
    "stream-chain": "2.2.5",
    "stream-json": "1.9.1"
  }
}
